# VERITAS Research Agent Configuration

# Environment
VERITAS_ENV=development
VERITAS_LOG_LEVEL=INFO

# LLM Providers (Optional for synthesis; fallback local heuristic supported)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web Search & Scraping
VERITAS_USER_AGENT=VeritasResearchAgent/1.0 (+https://github.com/Swapnil-Biswas/Veritas)
VERITAS_REQUEST_TIMEOUT=15.0
VERITAS_MAX_SEARCH_RESULTS=8
VERITAS_MAX_PAGE_CHARS=30000

# Security Boundaries
VERITAS_BLOCK_PRIVATE_IPS=true
VERITAS_NEUTRALIZE_PROMPT_INJECTIONS=true

# ---------------------------------------------------------------------------
# Seller backend (backend/) — placeholders only, never commit real values
# ---------------------------------------------------------------------------
# Bearer token issued by HireCrew after review. Required when VERITAS_ENV=production;
# in other environments a random per-process token is generated if unset.
HIRECREW_SELLER_TOKEN=replace-with-token-issued-by-hirecrew
VERITAS_HOST=127.0.0.1
VERITAS_PORT=8020
VERITAS_DB_PATH=./backend/data/veritas_jobs.db
# Comma-separated browser origins allowed by CORS (empty = CORS disabled; HireCrew is server-to-server)
VERITAS_CORS_ORIGINS=
# Trusted reverse-proxy addresses for X-Forwarded-* headers
VERITAS_FORWARDED_ALLOW_IPS=127.0.0.1

# Request limits
VERITAS_MAX_BRIEF_CHARS=50000
VERITAS_MAX_BODY_BYTES=262144

# Worker / queue
VERITAS_WORKER_CONCURRENCY=2
VERITAS_WORKER_POLL_SECONDS=1.0
VERITAS_AGENT_TIMEOUT_SECONDS=600
VERITAS_LEASE_SECONDS=660
VERITAS_MAX_ATTEMPTS=3
VERITAS_RETRY_BACKOFF_SECONDS=30

# Agent invocation profile (mapped onto agent.schemas.input.ResearchBriefInput)
VERITAS_AGENT_DEPTH=standard
VERITAS_AGENT_MAX_SOURCES=10
