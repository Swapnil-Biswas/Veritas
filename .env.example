# VERITAS Research Agent Configuration

# Environment
VERITAS_ENV=development
VERITAS_LOG_LEVEL=INFO

# LLM Providers (Optional for synthesis; fallback local heuristic supported)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Web Search & Scraping
VERITAS_USER_AGENT=VeritasResearchAgent/1.0 (+https://github.com/Swapnil-Biswas/Veritas)
VERITAS_REQUEST_TIMEOUT=15.0
VERITAS_MAX_SEARCH_RESULTS=8
VERITAS_MAX_PAGE_CHARS=30000

# Security Boundaries
VERITAS_BLOCK_PRIVATE_IPS=true
VERITAS_NEUTRALIZE_PROMPT_INJECTIONS=true
